{
  "name": "ave-mujica-fighter",
  "version": "2.0.0",
  "private": true,
  "description": "Vue 3 theatre fighter with a TypeScript combat core and authoritative WebSocket server",
  "main": "server.js",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/dev.ts",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.cjs",
    "start": "node scripts/ensure-build.cjs && node server.js",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "pnpm run build:server && node --import tsx --test tests/server-and-combat.test.js tests/audio-events.test.js",
    "balance": "node --import tsx simulate-balance.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": "11.25.0"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "vue": "3.4.21",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.18.6",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "5.2.4",
    "autoprefixer": "10.4.22",
    "esbuild": "0.25.10",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.5.1",
    "globals": "16.4.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "5.2.8",
    "vue-tsc": "2.2.12"
  }
}
